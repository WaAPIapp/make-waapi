{
    // Absolute, not relative: Make's base is inherited by modules and RPCs
    // only. A connection or webhook resolving "/instances" fails with
    // "Invalid URL" before any request is made.
    "url": "https://waapi.app/api/v1/instances",
    "method": "GET",
    "headers": {
        "authorization": "Bearer {{parameters.apiKey}}"
    },
    "response": {
        "error": {
            "message": "[{{statusCode}}] {{ifempty(body.message, 'The API token was rejected. Check that it exists and carries the read and update scopes.')}}"
        },
        "metadata": {
            "value": "{{ifempty(body.instances[].name, 'WaAPI account')}}"
        }
    },
    "log": {
        "sanitize": [
            "request.headers.authorization"
        ]
    }
}
