{
    // One stored value, not two. Building the path from instanceId and
    // subscriptionId separately means an empty half yields
    // ".../instances//webhooks/9" -- a 404 Make discards silently, leaving the
    // subscription alive and the instance posting to a dead scenario URL.
    // attach saves the finished URL, so detach has nothing left to assemble.
    "url": "{{webhook.detachUrl}}",
    "method": "DELETE",
    "response": {
        "error": {
            "message": "[{{statusCode}}] {{ifempty(body.message, 'Could not unsubscribe.')}}"
        }
    }
}
