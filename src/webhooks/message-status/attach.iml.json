{
    // Absolute, not relative: Make's base is inherited by modules and RPCs
    // only. A connection or webhook resolving "/instances" fails with
    // "Invalid URL" before any request is made.
    "url": "https://waapi.app/api/v1/instances/{{parameters.instanceId}}/webhooks",
    "method": "POST",
    "body": {
        "url": "{{webhook.url}}",
        "events": ["message_ack"],
        "source": "make"
    },
    "response": {
        "error": {
            "message": "[{{statusCode}}] {{ifempty(body.message, 'Could not subscribe. The API token needs the update scope.')}}"
        },
        "data": {
            "subscriptionId": "{{body.data.id}}",
            "instanceId": "{{parameters.instanceId}}",
            "detachUrl": "https://waapi.app/api/v1/instances/{{parameters.instanceId}}/webhooks/{{body.data.id}}"
        }
    }
}
